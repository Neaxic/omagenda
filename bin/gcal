#!/usr/bin/env python3
"""Google Calendar client for Omagenda.

Everything that talks to Google lives here: the OAuth dance, token refresh, and
the handful of API calls the plugin needs. Standard library only — no pip, no
vendored SDK — so the plugin stays a git clone with nothing to install.

Output is always JSON on stdout. Failures print {"error": ...} and exit non-zero,
so the QML side can surface the message instead of guessing from an exit code.

  gcal connect                   login, then the calendar list, in one pass
  gcal login                     browser consent, once
  gcal status                    is there a usable token, and for what
  gcal logout                    forget the tokens (the Google grant survives)
  gcal calendars                 the calendar list, with access roles
  gcal events <calId> [...]      changed events; --sync-token for incremental
  gcal insert <calId> <json>     create, prints the created event
  gcal patch  <calId> <id> <json>
  gcal delete <calId> <id>

Anywhere a <json> body or a sync token is taken, "-" means "read it from stdin"
instead, and that is what the plugin always passes. Arguments are not private:
/proc/<pid>/cmdline is world-readable, so an event title, location or set of
notes passed on the command line is readable by every local user for as long as
the write runs. Everything else the plugin stores is 0600 inside a 0700
directory, and stdin keeps the request body on the same side of that line.

The OAuth client comes from the first of these that has a client_id:

  1. $OMAGENDA_GOOGLE_CLIENT_ID / $OMAGENDA_GOOGLE_CLIENT_SECRET
  2. ~/.config/omagenda/google-client.json   — the user's own, if they want one
  3. <plugin>/google-app.json                — Omagenda's own, shipped

(3) is why a user only has to press a button: the app registration is the
plugin's, not theirs. A client shipped inside a desktop app is not a secret and
is not treated as one (RFC 8252 §8.5); PKCE is what actually protects the
exchange. (2) exists for anyone who would rather answer to their own Cloud
project — it wins over the shipped one.

Tokens live in ~/.config/omagenda/google-tokens.json at 0600 and are never
printed.

A calendar can be shared with the user by anyone, so its size is not the user's
to decide. Every read from Google therefore has a byte ceiling and every
paginated walk a budget across its pages — see MAX_RESPONSE_BYTES and Budget.
Going past one is an ordinary failure that saves no sync token, which leaves the
next pass to start where this one did rather than from a token that claimed to
have seen the pages we refused. tests/gcal.test.py holds those ceilings.
"""

import base64
import hashlib
import http.server
import json
import os
import secrets
import socketserver
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request

CONFIG_DIR = os.path.expanduser("~/.config/omagenda")
CLIENT_FILE = os.path.join(CONFIG_DIR, "google-client.json")
TOKEN_FILE = os.path.join(CONFIG_DIR, "google-tokens.json")

# bin/gcal -> the plugin root beside it, so the shipped client is found however
# the plugin was cloned or symlinked.
PLUGIN_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
APP_CLIENT_FILE = os.path.join(PLUGIN_DIR, "google-app.json")

AUTH_URL = "https://accounts.google.com/o/oauth2/v2/auth"
TOKEN_URL = "https://oauth2.googleapis.com/token"
REVOKE_URL = "https://oauth2.googleapis.com/revoke"
API = "https://www.googleapis.com/calendar/v3"

# Ceilings on anything read from Google. Nothing on the other end of these
# requests is ours: a calendar can be shared with the user by anyone, and holds
# whatever that person put in it. Both this helper and the long-lived shell that
# collects its output keep a whole reply in memory at once, and urlopen's
# timeout bounds how long a read may stall, not how much it may return — so
# every read gets a byte ceiling, and a paginated walk gets a budget across all
# of its pages (see Budget).
MAX_RESPONSE_BYTES = 8 * 1024 * 1024    # one HTTP reply
MAX_ERROR_BYTES = 64 * 1024             # an error body, which we only excerpt
MAX_SYNC_BYTES = 32 * 1024 * 1024       # every reply in one paginated walk
MAX_SYNC_ITEMS = 20000                  # events one walk may hold
MAX_SYNC_PAGES = 100                    # requests one walk may make
MAX_SYNC_SECONDS = 180                  # wall clock across the whole walk

# Event read/write plus a read-only look at which calendars exist. Deliberately
# not the blanket "calendar" scope: this cannot create or delete a calendar.
SCOPES = [
    "https://www.googleapis.com/auth/calendar.events",
    "https://www.googleapis.com/auth/calendar.calendarlist.readonly",
]


def die(message, code=1, **extra):
    payload = {"error": str(message)}
    payload.update(extra)
    print(json.dumps(payload))
    sys.exit(code)


def emit(payload):
    print(json.dumps(payload))


def human_bytes(count):
    if count >= 1024 * 1024:
        return "%d MB" % (count // (1024 * 1024))
    return "%d KB" % (count // 1024)


def read_capped(stream, limit, budget=None, what="Google's reply"):
    """Read a response body, refusing to grow past `limit` bytes.

    Asking for one byte more than the ceiling is what tells "exactly at the
    limit" apart from "there was more coming".
    """
    raw = stream.read(limit + 1)
    if len(raw) > limit:
        die("%s is larger than Omagenda will read (%s)." % (what, human_bytes(limit)),
            code=7, oversize=True)
    if budget is not None:
        budget.spend(len(raw))
    return raw


class Budget:
    """What one paginated walk may spend: bytes, items, requests, seconds.

    A ceiling per reply is not enough on its own, because a hundred pages just
    under it add up the same way; the byte count is therefore shared across
    every request the walk makes. Running out is a clean failure that saves no
    sync token — half a page set with a fresh token would tell the next pass
    that everything we dropped had already been seen.
    """

    def __init__(self, what, max_bytes=MAX_SYNC_BYTES, max_items=MAX_SYNC_ITEMS,
                 max_pages=MAX_SYNC_PAGES, seconds=MAX_SYNC_SECONDS):
        self.what = what
        self.max_bytes = max_bytes
        self.max_items = max_items
        self.max_pages = max_pages
        self.seconds = seconds
        self.deadline = time.monotonic() + seconds
        self.spent = 0
        self.pages = 0

    def page(self, held=0):
        """Charge for one more request. `held` is what the walk holds already."""
        if self.pages >= self.max_pages:
            self.stop("runs to more pages than Omagenda will walk (%d)" % self.max_pages)
        if held >= self.max_items:
            self.stop("holds more entries than Omagenda will read at once (%d)" % self.max_items)
        if time.monotonic() > self.deadline:
            self.stop("is taking longer to read than Omagenda will wait (%ds)" % self.seconds)
        self.pages += 1

    def spend(self, count):
        self.spent += count
        if self.spent > self.max_bytes:
            self.stop("is more data than Omagenda will read at once (%s)"
                      % human_bytes(self.max_bytes))

    def stop(self, why):
        die("%s %s. Nothing was saved. Narrow Omagenda's sync window, or stop "
            "syncing that calendar." % (self.what, why), code=7, oversize=True)


def read_arg(value):
    """An argument's value, read from stdin instead when the argument is "-".

    See the module docstring: this is how private event content stays out of
    /proc/<pid>/cmdline. Only "-" reads stdin, so nothing blocks waiting for
    input that was never going to come.
    """
    return sys.stdin.read() if value == "-" else value


def read_body(value):
    """Parse a request body given literally or, for "-", on stdin."""
    text = read_arg(value)
    try:
        return json.loads(text)
    except ValueError as exc:
        die("could not parse the event body (%s)" % exc)


def read_json(path, default=None):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return json.load(handle)
    except FileNotFoundError:
        return default
    except (ValueError, OSError) as exc:
        die("could not read %s: %s" % (os.path.basename(path), exc))


def write_private(path, data):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    tmp = path + ".tmp"
    # Create with 0600 from the start rather than chmod-ing after: the tokens
    # must never exist, even briefly, as a world-readable file.
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        json.dump(data, handle, indent=2)
        handle.write("\n")
    os.replace(tmp, path)


def client_from_file(path):
    """(client_id, client_secret) out of a console-style JSON file, or None."""
    config = read_json(path)
    if not isinstance(config, dict):
        return None
    # A file straight out of the console has everything under "installed".
    inner = config.get("installed") if isinstance(config.get("installed"), dict) else config
    client_id = str(inner.get("client_id", "")).strip()
    if not client_id:
        return None
    return client_id, str(inner.get("client_secret", "")).strip()


def resolve_client():
    """The OAuth client to use, and where it came from. (None, "") if unset."""
    env_id = os.environ.get("OMAGENDA_GOOGLE_CLIENT_ID", "").strip()
    if env_id:
        return (env_id, os.environ.get("OMAGENDA_GOOGLE_CLIENT_SECRET", "").strip()), "env"
    # The user's own client outranks the shipped one: if they went to the
    # trouble of registering a project, that is the one they meant.
    found = client_from_file(CLIENT_FILE)
    if found:
        return found, "user"
    found = client_from_file(APP_CLIENT_FILE)
    if found:
        return found, "builtin"
    return None, ""


def client_credentials():
    client, _origin = resolve_client()
    if not client:
        die("this copy of Omagenda ships no Google client, and you have not set "
            "one up. See docs/google-setup.md.", code=2, needs="client")
    return client


def post_form(url, fields):
    body = urllib.parse.urlencode(fields).encode()
    request = urllib.request.Request(url, data=body, method="POST")
    request.add_header("Content-Type", "application/x-www-form-urlencoded")
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            return json.loads(read_capped(
                response, MAX_RESPONSE_BYTES, what="Google's token reply").decode())
    except urllib.error.HTTPError as exc:
        detail = exc.read(MAX_ERROR_BYTES).decode(errors="replace")
        try:
            parsed = json.loads(detail)
        except ValueError:
            parsed = {"error": detail[:400]}
        return {"_http_error": exc.code, "_detail": parsed}
    except urllib.error.URLError as exc:
        die("network error talking to Google: %s" % exc.reason, code=3)


# --- oauth ---------------------------------------------------------------------

def pkce_pair():
    verifier = base64.urlsafe_b64encode(secrets.token_bytes(64)).decode().rstrip("=")
    digest = hashlib.sha256(verifier.encode()).digest()
    challenge = base64.urlsafe_b64encode(digest).decode().rstrip("=")
    return verifier, challenge


class CallbackHandler(http.server.BaseHTTPRequestHandler):
    result = {}

    def do_GET(self):  # noqa: N802 - http.server's naming
        query = urllib.parse.urlparse(self.path).query
        params = urllib.parse.parse_qs(query)
        CallbackHandler.result = {key: values[0] for key, values in params.items()}
        ok = "code" in CallbackHandler.result
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.end_headers()
        message = "Omagenda is connected. You can close this tab." if ok \
            else "Authorisation failed: " + CallbackHandler.result.get("error", "no code")
        self.wfile.write(
            ("<!doctype html><meta charset=utf-8>"
             "<body style='background:#0b0b0c;color:#e9e9e6;font:16px system-ui;"
             "display:grid;place-items:center;height:100vh;margin:0'>"
             "<p>%s</p>" % message).encode()
        )

    def log_message(self, *args):
        pass


def have_tokens():
    tokens = read_json(TOKEN_FILE)
    return bool(tokens and tokens.get("refresh_token"))


def do_login():
    client_id, client_secret = client_credentials()
    verifier, challenge = pkce_pair()
    state = secrets.token_urlsafe(24)

    with socketserver.TCPServer(("127.0.0.1", 0), CallbackHandler) as server:
        port = server.server_address[1]
        redirect_uri = "http://127.0.0.1:%d" % port
        params = {
            "client_id": client_id,
            "redirect_uri": redirect_uri,
            "response_type": "code",
            "scope": " ".join(SCOPES),
            "code_challenge": challenge,
            "code_challenge_method": "S256",
            "state": state,
            # offline + consent is what actually yields a refresh token; without
            # them a second login returns only an access token.
            "access_type": "offline",
            "prompt": "consent",
        }
        url = AUTH_URL + "?" + urllib.parse.urlencode(params)

        sys.stderr.write("Opening your browser to authorise Omagenda…\n")
        sys.stderr.write("If nothing opens, paste this into a browser:\n\n%s\n\n" % url)
        # Until Google has finished verifying the app registration, consent is
        # fronted by a scare screen. Saying so up front beats the user deciding
        # the plugin is malware halfway through.
        sys.stderr.write("If Google says it has not verified Omagenda, choose "
                         "Advanced → Go to Omagenda.\n")
        try:
            subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)
        except OSError:
            pass

        thread = threading.Thread(target=server.handle_request, daemon=True)
        thread.start()
        thread.join(timeout=300)

    result = CallbackHandler.result
    if not result:
        die("timed out waiting for the browser to come back", code=4)
    if result.get("state") != state:
        die("state mismatch — the callback did not come from this login", code=4)
    if "code" not in result:
        die("Google refused: " + result.get("error", "unknown"), code=4)

    fields = {
        "client_id": client_id,
        "code": result["code"],
        "code_verifier": verifier,
        "grant_type": "authorization_code",
        "redirect_uri": redirect_uri,
    }
    if client_secret:
        fields["client_secret"] = client_secret
    payload = post_form(TOKEN_URL, fields)
    if "_http_error" in payload:
        die("token exchange failed: %s" % json.dumps(payload["_detail"]), code=4)
    if "refresh_token" not in payload:
        die("Google returned no refresh token; revoke the app's access and try again", code=4)

    return save_tokens(payload)


def login():
    tokens = do_login()
    emit({"ok": True, "scopes": tokens.get("scope", "").split()})


def save_tokens(payload, keep_refresh=None):
    tokens = {
        "refresh_token": payload.get("refresh_token") or keep_refresh,
        "access_token": payload.get("access_token", ""),
        "expires_at": int(time.time()) + int(payload.get("expires_in", 0)) - 60,
        "scope": payload.get("scope", ""),
    }
    write_private(TOKEN_FILE, tokens)
    return tokens


def access_token():
    tokens = read_json(TOKEN_FILE)
    if not tokens or not tokens.get("refresh_token"):
        die("not signed in: run `gcal login`", code=2, needs="login")
    if tokens.get("access_token") and int(tokens.get("expires_at", 0)) > time.time():
        return tokens["access_token"]

    client_id, client_secret = client_credentials()
    fields = {
        "client_id": client_id,
        "refresh_token": tokens["refresh_token"],
        "grant_type": "refresh_token",
    }
    if client_secret:
        fields["client_secret"] = client_secret
    payload = post_form(TOKEN_URL, fields)
    if "_http_error" in payload:
        detail = payload["_detail"]
        if isinstance(detail, dict) and detail.get("error") == "invalid_grant":
            die("Google rejected the refresh token. If the OAuth consent screen "
                "is still in Testing, tokens expire after 7 days — publish it to "
                "In production, then run `gcal login` again.",
                code=5, needs="login")
        die("refresh failed: %s" % json.dumps(detail), code=5)
    return save_tokens(payload, keep_refresh=tokens["refresh_token"])["access_token"]


# --- api -----------------------------------------------------------------------

def api(path, method="GET", params=None, body=None, budget=None):
    url = API + path
    if params:
        url += "?" + urllib.parse.urlencode(params)
    data = json.dumps(body).encode() if body is not None else None
    request = urllib.request.Request(url, data=data, method=method)
    request.add_header("Authorization", "Bearer " + access_token())
    if data:
        request.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(request, timeout=45) as response:
            raw = read_capped(response, MAX_RESPONSE_BYTES, budget).decode()
            return json.loads(raw) if raw.strip() else {}
    except urllib.error.HTTPError as exc:
        detail = exc.read(MAX_ERROR_BYTES).decode(errors="replace")
        try:
            parsed = json.loads(detail).get("error", {})
        except ValueError:
            parsed = {"message": detail[:400]}
        # 410 means the sync token is too old to resume from; the caller has to
        # drop it and take a full pass. It is normal, not a failure.
        if exc.code == 410:
            return {"_gone": True}
        die("Google API %s: %s" % (exc.code, parsed.get("message", "")), code=6,
            status=exc.code)
    except urllib.error.URLError as exc:
        die("network error talking to Google: %s" % exc.reason, code=3)


def calendar_list():
    out, page = [], None
    budget = Budget("your calendar list")
    while True:
        budget.page(len(out))
        payload = api("/users/me/calendarList",
                      params={"maxResults": 250, "pageToken": page} if page
                      else {"maxResults": 250},
                      budget=budget)
        for item in payload.get("items", []):
            out.append({
                "id": item.get("id"),
                "name": item.get("summaryOverride") or item.get("summary"),
                "primary": bool(item.get("primary")),
                "accessRole": item.get("accessRole"),
                "writable": item.get("accessRole") in ("owner", "writer"),
                "backgroundColor": item.get("backgroundColor"),
                "selected": bool(item.get("selected")),
            })
        page = payload.get("nextPageToken")
        if not page:
            break
    return out


def calendars():
    emit({"calendars": calendar_list()})


def connect():
    """The one-press path: consent if needed, then say what there is to sync.

    Kept as a single command so the panel can run one process and get both
    halves of the answer, rather than chaining two and handling a login that
    succeeded followed by a list that failed.
    """
    fresh = False
    if not have_tokens():
        do_login()
        fresh = True
    found = calendar_list()
    primary = ""
    for item in found:
        if item.get("primary"):
            primary = item.get("id") or ""
            break
    emit({"ok": True, "fresh": fresh, "calendars": found, "primary": primary})


def events(calendar_id, sync_token=None, time_min=None, time_max=None):
    # singleEvents expands recurrences server side, so a Google event with a rule
    # we could not model arrives as plain instances we can.
    base = {"singleEvents": "true", "maxResults": 2500, "showDeleted": "true"}
    if sync_token:
        base["syncToken"] = sync_token
    else:
        if time_min:
            base["timeMin"] = time_min
        if time_max:
            base["timeMax"] = time_max
        base["orderBy"] = "startTime"

    items, page = [], None
    next_sync = None
    budget = Budget("that calendar")
    while True:
        budget.page(len(items))
        params = dict(base)
        if page:
            params["pageToken"] = page
            params.pop("timeMin", None)
            params.pop("timeMax", None)
            params.pop("orderBy", None)
            params.pop("syncToken", None)
        payload = api("/calendars/%s/events" % urllib.parse.quote(calendar_id),
                      params=params, budget=budget)
        if payload.get("_gone"):
            emit({"expired": True})
            return
        items.extend(payload.get("items", []))
        next_sync = payload.get("nextSyncToken") or next_sync
        page = payload.get("nextPageToken")
        if not page:
            break
    emit({"items": items, "syncToken": next_sync})


def main(argv):
    if len(argv) < 2:
        die("usage: gcal connect|login|status|logout|calendars|events|insert|patch|delete")
    command = argv[1]

    if command == "connect":
        return connect()

    if command == "login":
        return login()

    if command == "logout":
        tokens = read_json(TOKEN_FILE) or {}
        if tokens.get("refresh_token"):
            post_form(REVOKE_URL, {"token": tokens["refresh_token"]})
        try:
            os.remove(TOKEN_FILE)
        except FileNotFoundError:
            pass
        return emit({"ok": True})

    if command == "status":
        tokens = read_json(TOKEN_FILE)
        client, origin = resolve_client()
        return emit({
            "client": bool(client),
            # env | user | builtin — the panel says "your own Google project"
            # rather than "connected" when someone brought their own.
            "clientOrigin": origin,
            "authorized": bool(tokens and tokens.get("refresh_token")),
            "scopes": (tokens or {}).get("scope", "").split(),
            "expiresIn": max(0, int((tokens or {}).get("expires_at", 0) - time.time())),
        })

    if command == "calendars":
        return calendars()

    if command == "events":
        if len(argv) < 3:
            die("usage: gcal events <calendarId> [--sync-token T] [--from ISO] [--to ISO]")
        options = {}
        rest = argv[3:]
        for index in range(0, len(rest) - 1, 2):
            options[rest[index]] = rest[index + 1]
        token = options.get("--sync-token")
        return events(argv[2], read_arg(token).strip() if token else token,
                      options.get("--from"), options.get("--to"))

    if command == "insert":
        if len(argv) < 4:
            die("usage: gcal insert <calendarId> <json>|-")
        return emit(api("/calendars/%s/events" % urllib.parse.quote(argv[2]),
                        method="POST", body=read_body(argv[3])))

    if command == "patch":
        if len(argv) < 5:
            die("usage: gcal patch <calendarId> <eventId> <json>|-")
        return emit(api("/calendars/%s/events/%s" % (urllib.parse.quote(argv[2]),
                                                     urllib.parse.quote(argv[3])),
                        method="PATCH", body=read_body(argv[4])))

    if command == "delete":
        if len(argv) < 4:
            die("usage: gcal delete <calendarId> <eventId>")
        api("/calendars/%s/events/%s" % (urllib.parse.quote(argv[2]),
                                         urllib.parse.quote(argv[3])), method="DELETE")
        return emit({"ok": True})

    die("unknown command: " + command)


if __name__ == "__main__":
    main(sys.argv)
