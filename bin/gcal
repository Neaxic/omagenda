#!/usr/bin/env python3
"""Google Calendar client for Datebook.

Everything that talks to Google lives here: the OAuth dance, token refresh, and
the handful of API calls the plugin needs. Standard library only — no pip, no
vendored SDK — so the plugin stays a git clone with nothing to install.

Output is always JSON on stdout. Failures print {"error": ...} and exit non-zero,
so the QML side can surface the message instead of guessing from an exit code.

  gcal login                     browser consent, once
  gcal status                    is there a usable token, and for what
  gcal logout                    forget the tokens (the Google grant survives)
  gcal calendars                 the calendar list, with access roles
  gcal events <calId> [...]      changed events; --sync-token for incremental
  gcal insert <calId> <json>     create, prints the created event
  gcal patch  <calId> <id> <json>
  gcal delete <calId> <id>

Credentials live in ~/.config/datebook/google-client.json (yours, from the
Cloud console) and tokens in ~/.config/datebook/google-tokens.json, both 0600.
Neither is ever printed.
"""

import base64
import hashlib
import http.server
import json
import os
import secrets
import socketserver
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request

CONFIG_DIR = os.path.expanduser("~/.config/datebook")
CLIENT_FILE = os.path.join(CONFIG_DIR, "google-client.json")
TOKEN_FILE = os.path.join(CONFIG_DIR, "google-tokens.json")

AUTH_URL = "https://accounts.google.com/o/oauth2/v2/auth"
TOKEN_URL = "https://oauth2.googleapis.com/token"
REVOKE_URL = "https://oauth2.googleapis.com/revoke"
API = "https://www.googleapis.com/calendar/v3"

# Event read/write plus a read-only look at which calendars exist. Deliberately
# not the blanket "calendar" scope: this cannot create or delete a calendar.
SCOPES = [
    "https://www.googleapis.com/auth/calendar.events",
    "https://www.googleapis.com/auth/calendar.calendarlist.readonly",
]


def die(message, code=1, **extra):
    payload = {"error": str(message)}
    payload.update(extra)
    print(json.dumps(payload))
    sys.exit(code)


def emit(payload):
    print(json.dumps(payload))


def read_json(path, default=None):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return json.load(handle)
    except FileNotFoundError:
        return default
    except (ValueError, OSError) as exc:
        die("could not read %s: %s" % (os.path.basename(path), exc))


def write_private(path, data):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    tmp = path + ".tmp"
    # Create with 0600 from the start rather than chmod-ing after: the tokens
    # must never exist, even briefly, as a world-readable file.
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        json.dump(data, handle, indent=2)
        handle.write("\n")
    os.replace(tmp, path)


def client_credentials():
    config = read_json(CLIENT_FILE)
    if not config:
        die("no client credentials: see docs/google-setup.md, then write "
            + CLIENT_FILE, code=2, needs="client")
    client_id = str(config.get("client_id", "")).strip()
    secret = str(config.get("client_secret", "")).strip()
    # A file straight out of the console has everything under "installed".
    if not client_id and isinstance(config.get("installed"), dict):
        client_id = str(config["installed"].get("client_id", "")).strip()
        secret = str(config["installed"].get("client_secret", "")).strip()
    if not client_id:
        die("client_id missing from " + CLIENT_FILE, code=2, needs="client")
    return client_id, secret


def post_form(url, fields):
    body = urllib.parse.urlencode(fields).encode()
    request = urllib.request.Request(url, data=body, method="POST")
    request.add_header("Content-Type", "application/x-www-form-urlencoded")
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            return json.loads(response.read().decode())
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode(errors="replace")
        try:
            parsed = json.loads(detail)
        except ValueError:
            parsed = {"error": detail[:400]}
        return {"_http_error": exc.code, "_detail": parsed}
    except urllib.error.URLError as exc:
        die("network error talking to Google: %s" % exc.reason, code=3)


# --- oauth ---------------------------------------------------------------------

def pkce_pair():
    verifier = base64.urlsafe_b64encode(secrets.token_bytes(64)).decode().rstrip("=")
    digest = hashlib.sha256(verifier.encode()).digest()
    challenge = base64.urlsafe_b64encode(digest).decode().rstrip("=")
    return verifier, challenge


class CallbackHandler(http.server.BaseHTTPRequestHandler):
    result = {}

    def do_GET(self):  # noqa: N802 - http.server's naming
        query = urllib.parse.urlparse(self.path).query
        params = urllib.parse.parse_qs(query)
        CallbackHandler.result = {key: values[0] for key, values in params.items()}
        ok = "code" in CallbackHandler.result
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.end_headers()
        message = "Datebook is connected. You can close this tab." if ok \
            else "Authorisation failed: " + CallbackHandler.result.get("error", "no code")
        self.wfile.write(
            ("<!doctype html><meta charset=utf-8>"
             "<body style='background:#0b0b0c;color:#e9e9e6;font:16px system-ui;"
             "display:grid;place-items:center;height:100vh;margin:0'>"
             "<p>%s</p>" % message).encode()
        )

    def log_message(self, *args):
        pass


def login():
    client_id, client_secret = client_credentials()
    verifier, challenge = pkce_pair()
    state = secrets.token_urlsafe(24)

    with socketserver.TCPServer(("127.0.0.1", 0), CallbackHandler) as server:
        port = server.server_address[1]
        redirect_uri = "http://127.0.0.1:%d" % port
        params = {
            "client_id": client_id,
            "redirect_uri": redirect_uri,
            "response_type": "code",
            "scope": " ".join(SCOPES),
            "code_challenge": challenge,
            "code_challenge_method": "S256",
            "state": state,
            # offline + consent is what actually yields a refresh token; without
            # them a second login returns only an access token.
            "access_type": "offline",
            "prompt": "consent",
        }
        url = AUTH_URL + "?" + urllib.parse.urlencode(params)

        sys.stderr.write("Opening your browser to authorise Datebook…\n")
        sys.stderr.write("If nothing opens, paste this into a browser:\n\n%s\n\n" % url)
        try:
            subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)
        except OSError:
            pass

        thread = threading.Thread(target=server.handle_request, daemon=True)
        thread.start()
        thread.join(timeout=300)

    result = CallbackHandler.result
    if not result:
        die("timed out waiting for the browser to come back", code=4)
    if result.get("state") != state:
        die("state mismatch — the callback did not come from this login", code=4)
    if "code" not in result:
        die("Google refused: " + result.get("error", "unknown"), code=4)

    fields = {
        "client_id": client_id,
        "code": result["code"],
        "code_verifier": verifier,
        "grant_type": "authorization_code",
        "redirect_uri": redirect_uri,
    }
    if client_secret:
        fields["client_secret"] = client_secret
    payload = post_form(TOKEN_URL, fields)
    if "_http_error" in payload:
        die("token exchange failed: %s" % json.dumps(payload["_detail"]), code=4)
    if "refresh_token" not in payload:
        die("Google returned no refresh token; revoke the app's access and try again", code=4)

    save_tokens(payload)
    emit({"ok": True, "scopes": payload.get("scope", "").split()})


def save_tokens(payload, keep_refresh=None):
    tokens = {
        "refresh_token": payload.get("refresh_token") or keep_refresh,
        "access_token": payload.get("access_token", ""),
        "expires_at": int(time.time()) + int(payload.get("expires_in", 0)) - 60,
        "scope": payload.get("scope", ""),
    }
    write_private(TOKEN_FILE, tokens)
    return tokens


def access_token():
    tokens = read_json(TOKEN_FILE)
    if not tokens or not tokens.get("refresh_token"):
        die("not signed in: run `gcal login`", code=2, needs="login")
    if tokens.get("access_token") and int(tokens.get("expires_at", 0)) > time.time():
        return tokens["access_token"]

    client_id, client_secret = client_credentials()
    fields = {
        "client_id": client_id,
        "refresh_token": tokens["refresh_token"],
        "grant_type": "refresh_token",
    }
    if client_secret:
        fields["client_secret"] = client_secret
    payload = post_form(TOKEN_URL, fields)
    if "_http_error" in payload:
        detail = payload["_detail"]
        if isinstance(detail, dict) and detail.get("error") == "invalid_grant":
            die("Google rejected the refresh token. If the OAuth consent screen "
                "is still in Testing, tokens expire after 7 days — publish it to "
                "In production, then run `gcal login` again.",
                code=5, needs="login")
        die("refresh failed: %s" % json.dumps(detail), code=5)
    return save_tokens(payload, keep_refresh=tokens["refresh_token"])["access_token"]


# --- api -----------------------------------------------------------------------

def api(path, method="GET", params=None, body=None):
    url = API + path
    if params:
        url += "?" + urllib.parse.urlencode(params)
    data = json.dumps(body).encode() if body is not None else None
    request = urllib.request.Request(url, data=data, method=method)
    request.add_header("Authorization", "Bearer " + access_token())
    if data:
        request.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(request, timeout=45) as response:
            raw = response.read().decode()
            return json.loads(raw) if raw.strip() else {}
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode(errors="replace")
        try:
            parsed = json.loads(detail).get("error", {})
        except ValueError:
            parsed = {"message": detail[:400]}
        # 410 means the sync token is too old to resume from; the caller has to
        # drop it and take a full pass. It is normal, not a failure.
        if exc.code == 410:
            return {"_gone": True}
        die("Google API %s: %s" % (exc.code, parsed.get("message", "")), code=6,
            status=exc.code)
    except urllib.error.URLError as exc:
        die("network error talking to Google: %s" % exc.reason, code=3)


def calendars():
    out, page = [], None
    while True:
        payload = api("/users/me/calendarList",
                      params={"maxResults": 250, "pageToken": page} if page
                      else {"maxResults": 250})
        for item in payload.get("items", []):
            out.append({
                "id": item.get("id"),
                "name": item.get("summaryOverride") or item.get("summary"),
                "primary": bool(item.get("primary")),
                "accessRole": item.get("accessRole"),
                "writable": item.get("accessRole") in ("owner", "writer"),
                "backgroundColor": item.get("backgroundColor"),
                "selected": bool(item.get("selected")),
            })
        page = payload.get("nextPageToken")
        if not page:
            break
    emit({"calendars": out})


def events(calendar_id, sync_token=None, time_min=None, time_max=None):
    # singleEvents expands recurrences server side, so a Google event with a rule
    # we could not model arrives as plain instances we can.
    base = {"singleEvents": "true", "maxResults": 2500, "showDeleted": "true"}
    if sync_token:
        base["syncToken"] = sync_token
    else:
        if time_min:
            base["timeMin"] = time_min
        if time_max:
            base["timeMax"] = time_max
        base["orderBy"] = "startTime"

    items, page = [], None
    next_sync = None
    while True:
        params = dict(base)
        if page:
            params["pageToken"] = page
            params.pop("timeMin", None)
            params.pop("timeMax", None)
            params.pop("orderBy", None)
            params.pop("syncToken", None)
        payload = api("/calendars/%s/events" % urllib.parse.quote(calendar_id), params=params)
        if payload.get("_gone"):
            emit({"expired": True})
            return
        items.extend(payload.get("items", []))
        next_sync = payload.get("nextSyncToken") or next_sync
        page = payload.get("nextPageToken")
        if not page:
            break
    emit({"items": items, "syncToken": next_sync})


def main(argv):
    if len(argv) < 2:
        die("usage: gcal login|status|logout|calendars|events|insert|patch|delete")
    command = argv[1]

    if command == "login":
        return login()

    if command == "logout":
        tokens = read_json(TOKEN_FILE) or {}
        if tokens.get("refresh_token"):
            post_form(REVOKE_URL, {"token": tokens["refresh_token"]})
        try:
            os.remove(TOKEN_FILE)
        except FileNotFoundError:
            pass
        return emit({"ok": True})

    if command == "status":
        tokens = read_json(TOKEN_FILE)
        client = read_json(CLIENT_FILE)
        return emit({
            "client": bool(client),
            "authorized": bool(tokens and tokens.get("refresh_token")),
            "scopes": (tokens or {}).get("scope", "").split(),
            "expiresIn": max(0, int((tokens or {}).get("expires_at", 0) - time.time())),
        })

    if command == "calendars":
        return calendars()

    if command == "events":
        if len(argv) < 3:
            die("usage: gcal events <calendarId> [--sync-token T] [--from ISO] [--to ISO]")
        options = {}
        rest = argv[3:]
        for index in range(0, len(rest) - 1, 2):
            options[rest[index]] = rest[index + 1]
        return events(argv[2], options.get("--sync-token"),
                      options.get("--from"), options.get("--to"))

    if command == "insert":
        if len(argv) < 4:
            die("usage: gcal insert <calendarId> <json>")
        return emit(api("/calendars/%s/events" % urllib.parse.quote(argv[2]),
                        method="POST", body=json.loads(argv[3])))

    if command == "patch":
        if len(argv) < 5:
            die("usage: gcal patch <calendarId> <eventId> <json>")
        return emit(api("/calendars/%s/events/%s" % (urllib.parse.quote(argv[2]),
                                                     urllib.parse.quote(argv[3])),
                        method="PATCH", body=json.loads(argv[4])))

    if command == "delete":
        if len(argv) < 4:
            die("usage: gcal delete <calendarId> <eventId>")
        api("/calendars/%s/events/%s" % (urllib.parse.quote(argv[2]),
                                         urllib.parse.quote(argv[3])), method="DELETE")
        return emit({"ok": True})

    die("unknown command: " + command)


if __name__ == "__main__":
    main(sys.argv)
