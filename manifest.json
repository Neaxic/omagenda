{
  "schemaVersion": 1,
  "id": "io.github.neaxic.omagenda",
  "name": "Omagenda",
  "version": "0.1.0",
  "author": "andre",
  "license": "MIT",
  "description": "A calendar in the Omarchy bar: a rolling grid of the week you are in and the two ahead, a year view, a day agenda with event detail and compose pages, and your own events kept in a plain JSON file. Google Calendar syncs both ways at one button press, or leave it off and stay entirely local.",
  "keywords": [
    "calendar",
    "events",
    "agenda",
    "month",
    "dates",
    "time",
    "google"
  ],
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Omagenda",
    "description": "A rolling three-week calendar that expands to a month, with a day agenda and event pages.",
    "category": "Time",
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "barMode": "next",
      "barIcon": "calendar",
      "barMaxTitle": 18,
      "weekStartsMonday": true,
      "showWeekNumbers": true,
      "use24Hour": true,
      "upcomingDays": 14,
      "displayFont": "auto",
      "weeksShown": 3,
      "eventPalette": "spread"
    },
    "schema": [
      {
        "key": "barMode",
        "type": "enum",
        "label": "Bar shows",
        "options": [
          "next",
          "date",
          "count",
          "clock",
          "icon"
        ],
        "defaultValue": "next"
      },
      {
        "key": "barIcon",
        "type": "enum",
        "label": "Bar icon",
        "options": [
          "calendar",
          "month",
          "today",
          "blank",
          "clock",
          "none"
        ],
        "defaultValue": "calendar"
      },
      {
        "key": "barMaxTitle",
        "type": "integer",
        "label": "Longest event title in the bar (characters)",
        "min": 6,
        "max": 48,
        "step": 1,
        "defaultValue": 18
      },
      {
        "key": "displayFont",
        "type": "string",
        "label": "Headline font — \"auto\" picks an installed grotesque, \"theme\" keeps the bar's font, or name a family",
        "defaultValue": "auto"
      },
      {
        "key": "weekStartsMonday",
        "type": "boolean",
        "label": "Week starts on Monday",
        "defaultValue": true
      },
      {
        "key": "showWeekNumbers",
        "type": "boolean",
        "label": "Show ISO week numbers",
        "defaultValue": true
      },
      {
        "key": "weeksShown",
        "type": "integer",
        "label": "Weeks the grid shows, counting the one you are in",
        "min": 1,
        "max": 8,
        "step": 1,
        "defaultValue": 3
      },
      {
        "key": "eventPalette",
        "type": "enum",
        "label": "Event colours: spread (six hues off the theme accent) or theme (the theme's own slots)",
        "options": [
          "spread",
          "theme"
        ],
        "defaultValue": "spread"
      },
      {
        "key": "use24Hour",
        "type": "boolean",
        "label": "24-hour times",
        "defaultValue": true
      },
      {
        "key": "upcomingDays",
        "type": "integer",
        "label": "Days ahead the upcoming list covers",
        "min": 1,
        "max": 90,
        "step": 1,
        "defaultValue": 14
      }
    ]
  }
}
