#!/usr/bin/env bash
# Stamp the real domain and contact address into the site.
#
# The pages ship with two placeholders so they can live in git before the domain
# exists. Run this once, from this directory, after registering it:
#
#   ./configure datebook.app you@example.com
#
# Re-running with a different domain works: the old value is replaced too.
set -euo pipefail

if [ $# -ne 2 ]; then
  echo "usage: ./configure <domain> <contact-email>" >&2
  echo "   eg: ./configure datebook.app you@example.com" >&2
  exit 2
fi

domain="$1"
email="$2"

case "$domain" in
  *://*) echo "give the bare domain, not a URL" >&2; exit 2 ;;
  */*)   echo "give the bare domain, no path" >&2; exit 2 ;;
  *.*)   ;;
  *)     echo "that does not look like a domain" >&2; exit 2 ;;
esac
case "$email" in
  *@*.*) ;;
  *) echo "that does not look like an email address" >&2; exit 2 ;;
esac

# Whatever domain is in there now — the placeholder, or a previous run's value.
current=$(sed -n 's#.*<link rel="canonical" href="https://\([^/]*\)/".*#\1#p' index.html | head -1)
: "${current:=datebook.example}"

current_email=$(sed -n 's#.*mailto:\([^"]*\)".*#\1#p' index.html | head -1)
: "${current_email:=CONTACT_EMAIL}"

for file in index.html privacy/index.html; do
  sed -i "s#${current}#${domain}#g; s#${current_email}#${email}#g" "$file"
done

echo "Site configured:"
echo "  homepage        https://${domain}/"
echo "  privacy policy  https://${domain}/privacy/"
echo "  contact         ${email}"
echo
echo "Both URLs go in the Google Cloud console's branding screen, and ${domain}"
echo "goes in Authorized domains. Verify ${domain} in Search Console first."
